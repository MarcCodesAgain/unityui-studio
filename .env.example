# Copy to .env.local for local development. On Vercel, set these in
# Project Settings > Environment Variables.

# Required for live generation. Without it the studio still shows the examples.
ANTHROPIC_API_KEY=

# Generations allowed per IP and in total, per day (per server instance).
STUDIO_LIMIT_PER_IP=15
STUDIO_LIMIT_GLOBAL=400

# Development only: replay an example instead of calling the API.
# STUDIO_FAKE_STREAM=1
